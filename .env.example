# Backend
PLANTGUARDIAN_USE_DATABASE=false
DATABASE_URL=sqlite:///./plantguardian.db

# MQTT
# PLANTGUARDIAN_MQTT_ENABLED controls command publishing to iot/riego/comandos.
# PLANTGUARDIAN_MQTT_INGEST_ENABLED controls subscription to iot/riego/datos.
PLANTGUARDIAN_MQTT_ENABLED=false
PLANTGUARDIAN_MQTT_INGEST_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=plantguardian-backend

# PostgreSQL example
# PLANTGUARDIAN_USE_DATABASE=true
# DATABASE_URL=postgresql+psycopg://plantguardian:plantguardian@localhost:5432/plantguardian